# ─── DATABASE ─────────────────────────────────────────────────────────────────
# DATA_MODE: mock = datos en memoria (desarrollo local, sin base de datos)
#            prisma = PostgreSQL real (producción)
DATA_MODE=mock
DATABASE_URL=postgresql://queen_user:queen_password@localhost:5432/queen_style_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_for_access
JWT_REFRESH_SECRET=change_me_to_a_long_random_string_for_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── STORAGE ──────────────────────────────────────────────────────────────────
# Provider: local | s3 | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 / Cloudflare R2 (fill when switching from local)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# ─── WHATSAPP ─────────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=584120000000

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── BCRYPT ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# ---- DOCKER COMPOSE (opcional) ----
# Puerto del frontend publicado por docker compose. Por defecto 8080 para no chocar con Traefik (80/443).
WEB_PORT=8080
# Puerto de Postgres: solo aplica con docker-compose.db-port.yml (override local)
POSTGRES_PORT=5432
